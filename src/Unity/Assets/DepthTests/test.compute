// EnvironmentDepthReproject.compute
#pragma kernel ReprojectDepth

// Meta environment depth texture (RenderTexture with dimension = Tex2DArray)
Texture2DArray<float> _EnvDepthTex;

// Output: XR-camera-aligned depth (meters)
RWTexture2D<float> _OutDepth;

// Inverse of _EnvironmentDepthReprojectionMatrices (2 matrices: left/right)
float4x4 _EnvReprojInv[2];

// XR camera view matrices (Unity view space: world → view)
float4x4 _XRCameraView_L;
float4x4 _XRCameraView_R;

// Tracking-space → Unity-world
float4x4 _TrackingToUnity;

// Size
int _Width;
int _Height;

// Eye index (0 = left eye, 1 = right eye); env depth is mono, we always use slice 0 but
// we still let the math be per-eye if you want to extend later.
int _EyeIndex;   // 0 or 1

float RawDepthToNDC(float d)
{
    // env depth is UNORM [0..1] → NDC z [-1..1]
    return d * 2.0 - 1.0;
}

[numthreads(8, 8, 1)]
void ReprojectDepth(uint3 id : SV_DispatchThreadID)
{
    uint2 pix = id.xy;
    if (pix.x >= _Width || pix.y >= _Height)
        return;

    int eye = _EyeIndex; // we use 0 (left) from C#

    // 1) Sample raw env depth from slice 0 (mono depth)
    float rawDepth = _EnvDepthTex.Load(int4(pix.x, pix.y, 0, 0)).r;
    if (rawDepth <= 0.0)
    {
        _OutDepth[pix] = 0.0;
        return;
    }

    // 2) Build depth-camera clip position from pixel + depth
    float2 uv     = (float2(pix) + 0.5) / float2(_Width, _Height);
    float2 ndcXY  = uv * 2.0 - 1.0;
    float  ndcZ   = RawDepthToNDC(rawDepth);

    // depth camera clip space
    float4 depthClip = float4(ndcXY.x, ndcXY.y, ndcZ, 1.0);

    // 3) depth clip → tracking-space world using inverse reprojection
    float4 worldTracking = mul(_EnvReprojInv[eye], depthClip);
    worldTracking /= worldTracking.w;

    // 4) tracking-space world → Unity world
    float4 worldUnity = mul(_TrackingToUnity, worldTracking);

    // 5) Unity world → XR camera view
    float4 viewPos = mul(
        (eye == 0 ? _XRCameraView_L : _XRCameraView_R),
        worldUnity
    );

    // 6) Camera-space depth, meters (Unity view space: forward = -Z)
    float depthMeters = -viewPos.z;
    if (depthMeters < 0.0)
        depthMeters = 0.0;

    _OutDepth[pix] = depthMeters;
}
